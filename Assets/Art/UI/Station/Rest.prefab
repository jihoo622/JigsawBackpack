  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 6\uC2DC\uAC04\uB9C8\uB2E4 \uC5F4\uCC28 \uC804\uCCB4 \uD654\uBB3C\uCE78\uC758
    \uC2DC\uB108\uC9C0 \uD6A8\uACFC\uAC00 \uC815\uC0B0\uB418\uC5B4 \uAC00\uCE58\uC5D0
    \uBC18\uC601\uB429\uB2C8\uB2E4.\n\n\u2022 \uC815\uC0B0 \uC8FC\uAE30\uB9C8\uB2E4
    \uC2E0\uC120 \uC2DD\uD488\uC758 \uC2E0\uC120\uB3C4\uAC00 \uAC10\uC18C\uD569\uB2C8\uB2E4.\n\n\u2022
    \uC57C\uAC04(22:00 ~ 06:00)\uC5D0\uB294 \uC2DC\uC7A5\uC744 \uC774\uC6A9\uD560
    \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uC774\uB3D9\uD558\uAC70\uB098 \uC544\uCE68\uAE4C\uC9C0
    \uB300\uAE30\uD558\uC138\uC694."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b2eeb73aa1ee10b48a7fe11797ba93c5, type: 2}
